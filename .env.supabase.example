# Private CLI configuration; copy to .env.supabase (not loaded by npm run dev).
# Add only the runtime variables below in Vercel Settings -> Environment Variables.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SECRET_KEY=sb_secret_REPLACE_WITH_YOUR_SERVER_SECRET_KEY
SUPABASE_MEDIA_BUCKET=little-readers-media
# A legacy SUPABASE_SERVICE_ROLE_KEY is also supported instead of SECRET_KEY.

# Local administration only; do not add this token to Vercel or NEXT_PUBLIC_*.
# Create a scoped PAT at https://supabase.com/dashboard/account/tokens
# Scope: the current project, Database (Read-write), Migrations (Read-write).
# The project reference is derived from SUPABASE_URL; no database password needed.
SUPABASE_ACCESS_TOKEN=
